{
  "position": "top",
  "height": 40,
  "icon_theme": "Marwaita",
  "start": [
    {
      "type": "menu",
      "label": "󱓞"
    },
    {
      "type": "launcher",
      "favorites": [
        "nautilus",
        "ghostty",
        "brave",
        "shelly"
      ],
      "truncate": {
        "mode": "end",
        "max_length": 30
      }
    }
  ],
  "center": [
    {
      "type": "clock",
      "format": "%b %d, %H:%M",
      "show_week_numbers": true
    }
  ],
  "end": [
    {
      "type": "tray"
    },
    {
      "type": "volume",
      "orientation": "horizontal"
    },
    {
      "type": "custom",
      "name": "power-menu",
      "class": "power-menu",
      "bar": [
        {
          "type": "button",
          "name": "power-btn",
          "label": "",
          "on_click": "popup:toggle"
        }
      ],
      "popup": [
        {
          "type": "box",
          "orientation": "vertical",
          "widgets": [
            {
              "type": "label",
              "name": "header",
              "label": "Power menu"
            },
            {
              "type": "box",
              "name": "buttons",
              "widgets": [
              {
                "type": "button",
                "class": "power-btn",
                "label": "<span>󰍁</span>",
                "cmd": "veila lock"
              },
                {
                  "type": "button",
                  "class": "power-btn",
                  "label": "<span>󰜉</span>",
                  "on_click": "!reboot"
                },
                {
                  "type": "button",
                  "class": "power-btn",
                  "label": "<span>󰐥</span>",
                  "on_click": "!shutdown now"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
